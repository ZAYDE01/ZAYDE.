// Pega DENTRO de  match /databases/{database}/documents { ... }  de tus reglas actuales.
function isAdmin(){ return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

match /sellerTickets/{id} {
  allow read:   if request.auth != null && (resource.data.sellerId == request.auth.uid || isAdmin());
  allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid
                && request.resource.data.status == 'abierto'
                && request.resource.data.message is string && request.resource.data.message.size() <= 1500
                && !('reply' in request.resource.data);
  allow update: if isAdmin();
  allow delete: if false;
}
match /sellerPrefs/{uid} {
  allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
}
