rules_version = '2';

// ============================================================
// REGLAS DE FIRESTORE — ZAYDE (versión endurecida)
//
// Cómo instalarlas:
//   Firebase Console > Firestore Database > Reglas > pega este archivo
//   completo > Publicar. (Si hay un error de sintaxis, la consola lo marca
//   y NO publica nada.)
//
// IMPORTANTE — orden de despliegue: primero sube a Vercel los archivos nuevos
// (api/_lib/stockReservations.js, send-email.js,
// stripe-webhook.js e index.html) y SOLO DESPUÉS publica estas reglas.
//
// Qué cambió respecto a tus reglas anteriores:
//   - inventory: lectura pública, pero ESCRITURA solo admin (la reserva de
//     stock ahora la hace el servidor, /api/send-email (type "stock-reserve")).
//   - orders: ya no se puede CREAR un pedido que diga "pagado", y un pedido
//     ya pagado ya no se puede marcar como "fallido" desde el navegador.
//   - priceHistory: ya no se escribe desde el navegador (lo registra el
//     webhook de Stripe cuando el pago se confirma).
//   - dropSubscribers: solo el dueño del correo (o el admin) puede crear,
//     editar o borrar su registro.
//   - push_subscriptions: solo se aceptan suscripciones de los servicios de
//     notificaciones reales (Google, Mozilla, Apple, Microsoft).
//   - productPresence: solo se acepta el campo "at" (número).
//   - abandonedCarts: el navegador ya no puede marcar "correo enviado".
//   - emailOtps y stockReservations: cerradas por completo (solo servidor).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Vendedor con ficha en "sellers" y estado "activo".
    function isActiveSeller() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'activo';
    }

    // La sesión de Firebase actual tiene un correo y es igual a este.
    function isOwnerEmail(email) {
      return request.auth != null &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        email is string &&
        email.lower() == request.auth.token.email.lower();
    }

    // ---- admins: nadie lee ni escribe esto desde el cliente. ----
    match /admins/{uid} {
      allow read, write: if false;
    }

    // ---- Vendedores ----
    match /sellers/{sellerUid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == sellerUid);
      allow write: if isAdmin();
    }

    match /sellerSales/{saleId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Vínculo privado venta -> pedido real. Lo escribe el webhook (Admin SDK).
    match /sellerSalesPrivate/{saleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sellerPayouts/{payoutId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---- Catálogo controlado por el panel admin ----
    match /admin_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_overrides/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_meta/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Reseñas: solo se escriben desde /api/submit-review.js ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Pedidos ----
    match /orders/{orderNum} {
      // Un pedido puntual por su número: público (rastreo sin cuenta).
      allow get: if true;
      // Listar TODOS los pedidos: solo admin.
      allow list: if isAdmin();

      // [CAMBIO] Crear: el cliente (sin cuenta) solo puede crear un pedido
      // "pendiente" cuyo número coincida con el ID del documento. Ya NO puede
      // crearlo como "pagado": marcar un pedido como pagado es solo del
      // webhook de Stripe (Admin SDK) o del admin. El sitio guarda el pedido
      // como "pendiente" ANTES de cobrar, así que el flujo normal no cambia.
      allow create: if isAdmin() || (
        request.resource.data.paymentStatus == 'pendiente' &&
        request.resource.data.orderNum == orderNum
      );

      // [CAMBIO] Actualizar: el cliente solo puede marcar SU pedido como
      // "fallido" (campos de pago fallido), y ya NO si el pedido está pagado.
      allow update: if isAdmin() || (
        resource.data.paymentStatus != 'pagado' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paymentFailReason', 'paymentFailedAt']) &&
        request.resource.data.paymentStatus == 'fallido'
      );

      allow delete: if isAdmin();
    }

    // ---- Historial de precios (gráfica pública de cada producto) ----
    // [CAMBIO] Lectura pública; ya NO se puede escribir desde el navegador:
    // lo registra el webhook de Stripe (Admin SDK) con el pago confirmado.
    match /priceHistory/{entryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- Presencia en vivo ("X personas viendo esto ahora") ----
    // [CAMBIO] Solo se acepta exactamente { at: número }.
    match /productPresence/{productId}/viewers/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['at'])
                              && request.resource.data.at is number;
      allow delete: if true;
    }

    // ---- Suscripciones push ----
    // [CAMBIO] Cualquier visitante puede registrar SU dispositivo, pero solo con
    // la forma exacta que genera el navegador y solo de los servicios de push
    // reales (evita que alguien registre direcciones arbitrarias a las que el
    // servidor intentaría mandar notificaciones).
    match /push_subscriptions/{subId} {
      allow create: if request.resource.data.keys().hasOnly(['subscription', 'createdAt'])
                      && request.resource.data.createdAt is number
                      && request.resource.data.subscription is map
                      && request.resource.data.subscription.size() <= 3
                      && request.resource.data.subscription.endpoint is string
                      && request.resource.data.subscription.endpoint.size() < 800
                      && request.resource.data.subscription.endpoint.matches(
                           'https://([a-z0-9-]+\\.)*(googleapis\\.com|mozilla\\.com|apple\\.com|windows\\.com)/.*');
      allow read, update, delete: if isAdmin();
    }

    // ---- Inventario en vivo ----
    // [CAMBIO] Lectura pública (el sitio muestra el stock en tiempo real).
    // Escritura SOLO del admin (panel de productos y devoluciones). Las
    // compras ya no escriben aquí desde el navegador: las reserva el servidor
    // con el Admin SDK (/api/send-email (type "stock-reserve")), que ignora estas reglas.
    match /inventory/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Reservas de stock: solo servidor (Admin SDK) ----
    match /stockReservations/{resId} {
      allow read, write: if false;
    }

    // ---- Códigos de verificación de correo: solo servidor (Admin SDK) ----
    match /emailOtps/{uid} {
      allow read, write: if false;
    }

    // ---- Newsletter (popup "10% en tu primera compra") ----
    match /newsletterSubscribers/{email} {
      allow create, update: if request.resource.data.keys().hasOnly(['email', 'date'])
                              && request.resource.data.email is string
                              && request.resource.data.email.size() < 200;
      allow read, delete: if isAdmin();
    }

    // ---- Aviso de Drop en vivo ----
    // [CAMBIO] Antes cualquiera podía borrar o pisar el registro de cualquier
    // correo. Ahora solo el dueño del correo (sesión de Firebase con ESE correo)
    // o el admin puede crear, editar o borrar.
    match /dropSubscribers/{email} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'date']) &&
        request.resource.data.email.size() < 200 &&
        isOwnerEmail(request.resource.data.email)
      );
      allow update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'date']) &&
        request.resource.data.email.size() < 200 &&
        isOwnerEmail(resource.data.get('email', '')) &&
        isOwnerEmail(request.resource.data.email)
      );
      allow delete: if isAdmin() || isOwnerEmail(resource.data.get('email', ''));
      allow read: if isAdmin();
    }

    // ---- Carrito abandonado ----
    // [CAMBIO] El navegador ya no puede marcar "correo enviado" (emailSent /
    // emailSentAt): eso solo lo hace /api/send-abandoned-cart-emails.js con el
    // Admin SDK. Sí puede poner emailSent:false al re-guardar un carrito nuevo.
    match /abandonedCarts/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'items', 'total', 'updatedAt', 'status', 'emailSent', 'emailSentAt'])
                      && request.resource.data.email is string
                      && request.resource.data.email.size() < 200
                      && (!('items' in request.resource.data) ||
                          (request.resource.data.items is list && request.resource.data.items.size() <= 50))
                      && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'recovered'])
                      && (!('emailSent' in request.resource.data) || request.resource.data.emailSent == false)
                      && !('emailSentAt' in request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(['email', 'items', 'total', 'updatedAt', 'status', 'emailSent', 'emailSentAt'])
                      && request.resource.data.email is string
                      && request.resource.data.email.size() < 200
                      && (!('items' in request.resource.data) ||
                          (request.resource.data.items is list && request.resource.data.items.size() <= 50))
                      && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'recovered'])
                      && (request.resource.data.get('emailSent', false) == false ||
                          request.resource.data.get('emailSent', false) == resource.data.get('emailSent', false))
                      && request.resource.data.get('emailSentAt', null) == resource.data.get('emailSentAt', null);
      allow read, delete: if isAdmin();
    }

    // Por defecto, todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
