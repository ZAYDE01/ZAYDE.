rules_version = '2';

// ============================================================
// REGLAS DE FIRESTORE — ZAYDE (versión endurecida)
//
// Cómo instalarlas:
//   Firebase Console > Firestore Database > Reglas > pega este archivo
//   completo > Publicar. (Si hay un error de sintaxis, la consola lo marca
//   y NO publica nada.)
//
// IMPORTANTE — orden de despliegue: primero sube a Vercel los archivos nuevos
// (api/_lib/stockReservations.js, send-email.js,
// stripe-webhook.js e index.html) y SOLO DESPUÉS publica estas reglas.
//
// Qué cambió respecto a tus reglas anteriores:
//   - inventory: lectura pública, pero ESCRITURA solo admin (la reserva de
//     stock ahora la hace el servidor, /api/send-email (type "stock-reserve")).
//   - orders: ya no se puede CREAR un pedido que diga "pagado", y un pedido
//     ya pagado ya no se puede marcar como "fallido" desde el navegador.
//   - priceHistory: ya no se escribe desde el navegador (lo registra el
//     webhook de Stripe cuando el pago se confirma).
//   - dropSubscribers: solo el dueño del correo (o el admin) puede crear,
//     editar o borrar su registro.
//   - push_subscriptions: solo se aceptan suscripciones de los servicios de
//     notificaciones reales (Google, Mozilla, Apple, Microsoft).
//   - productPresence: solo se acepta el campo "at" (número).
//   - abandonedCarts: el navegador ya no puede marcar "correo enviado".
//   - emailOtps y stockReservations: cerradas por completo (solo servidor).
//   - sellerSubmissions: propuestas de piezas del vendedor (crea solo
//     las suyas en estado "propuesta"; el admin cambia el estado) y sellerDocs:
//     documentos fiscales (solo el admin sube; cada vendedor lee los suyos).
//   - stockLog: historial de movimientos de stock de las piezas de
//     cada vendedor. Solo el admin escribe; cada vendedor activo lee solo
//     los suyos (portal del vendedor).
//   - [NUEVO] sellerTickets: reportes de soporte, disputas y solicitudes de
//     regreso de piezas con folio. El vendedor activo crea y lee solo los
//     suyos; responder y cambiar el estado es solo del admin.
//   - [NUEVO] sellerPrefs: preferencias de avisos (campanita, correo, push).
//     Cada vendedor activo lee y escribe solo las suyas.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Vendedor con ficha en "sellers" y estado "activo".
    function isActiveSeller() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/sellers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'activo';
    }

    // La sesión de Firebase actual tiene un correo y es igual a este.
    function isOwnerEmail(email) {
      return request.auth != null &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        email is string &&
        email.lower() == request.auth.token.email.lower();
    }

    // ---- admins: nadie lee ni escribe esto desde el cliente. ----
    match /admins/{uid} {
      allow read, write: if false;
    }

    // ---- Vendedores ----
    match /sellers/{sellerUid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == sellerUid);
      allow write: if isAdmin();
    }

    match /sellerSales/{saleId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Vínculo privado venta -> pedido real. Lo escribe el webhook (Admin SDK).
    match /sellerSalesPrivate/{saleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sellerPayouts/{payoutId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Historial de movimientos de stock (altas y ajustes del admin).
    // Cada renglón lleva el sellerId del dueño de la pieza; el vendedor solo
    // puede leer los suyos y nunca escribir.
    match /stockLog/{logId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Propuestas de piezas del vendedor (portal: "Mis piezas").
    // El vendedor activo solo CREA propuestas suyas en estado "propuesta" y con
    // la forma exacta del formulario; lee solo las suyas. Cambiar el estado,
    // poner el motivo de rechazo o las fotos de verificación es solo del admin.
    match /sellerSubmissions/{subId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow create: if isAdmin() || (
        isActiveSeller() &&
        request.resource.data.keys().hasOnly(['sellerId', 'sellerName', 'store', 'name', 'brand', 'category', 'size', 'price', 'desc', 'photos', 'proofs', 'status', 'createdAt', 'statusUpdatedAt']) &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'propuesta' &&
        request.resource.data.store in ['zayde', 'clothesg'] &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.brand is string && request.resource.data.brand.size() <= 60 &&
        request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40 &&
        request.resource.data.size is string && request.resource.data.size.size() > 0 && request.resource.data.size.size() <= 20 &&
        request.resource.data.desc is string && request.resource.data.desc.size() <= 600 &&
        request.resource.data.price is number && request.resource.data.price > 0 &&
        request.resource.data.photos is list && request.resource.data.photos.size() >= 1 && request.resource.data.photos.size() <= 5 &&
        request.resource.data.proofs is list && request.resource.data.proofs.size() <= 3 &&
        request.resource.data.createdAt is number && request.resource.data.statusUpdatedAt is number
      );
      allow update, delete: if isAdmin();
    }

    // Documentos fiscales (constancias de retención, facturas). Solo el
    // admin los sube; cada vendedor activo lee solo los suyos.
    match /sellerDocs/{docId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // [NUEVO] Reportes de soporte con folio (portal: Ayuda > Soporte).
    // El vendedor activo CREA reportes suyos, en estado "abierto", con la
    // forma exacta del formulario y sin respuesta; lee solo los suyos.
    // Responder, cambiar el estado o borrar es solo del admin.
    match /sellerTickets/{ticketId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow create: if isActiveSeller() &&
        request.resource.data.keys().hasOnly(['folio', 'sellerId', 'sellerName', 'email', 'type', 'ref', 'subject', 'message', 'status', 'createdAt']) &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'abierto' &&
        request.resource.data.type in ['soporte', 'disputa', 'regreso', 'envio'] &&
        request.resource.data.folio is string && request.resource.data.folio.size() <= 30 &&
        request.resource.data.subject is string && request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 100 &&
        request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 1500 &&
        request.resource.data.ref is string && request.resource.data.ref.size() <= 120 &&
        request.resource.data.createdAt is number;
      allow update, delete: if isAdmin();
    }

    // [NUEVO] Solicitudes de cambio de datos de pago. El vendedor activo crea
    // solo las suyas, "pendiente" y con el correo de SU sesión; aprobar o
    // rechazar (y escribir los datos nuevos en "sellers") es solo del admin.
    match /sellerChangeRequests/{reqId} {
      allow read: if isAdmin() || (isActiveSeller() && resource.data.sellerId == request.auth.uid);
      allow create: if isActiveSeller() &&
        request.resource.data.keys().hasOnly(['sellerId', 'sellerName', 'email', 'type', 'bank', 'holder', 'clabe', 'oldPayout', 'status', 'createdAt']) &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.type == 'pago' &&
        isOwnerEmail(request.resource.data.email) &&
        request.resource.data.bank is string && request.resource.data.bank.size() >= 3 && request.resource.data.bank.size() <= 60 &&
        request.resource.data.holder is string && request.resource.data.holder.size() >= 5 && request.resource.data.holder.size() <= 100 &&
        request.resource.data.clabe is string && request.resource.data.clabe.matches('^[0-9]{18}$') &&
        request.resource.data.oldPayout is string && request.resource.data.oldPayout.size() <= 300 &&
        request.resource.data.createdAt is number;
      allow update, delete: if isAdmin();
    }

    // [NUEVO] Preferencias de avisos del vendedor (campanita, correo, push).
    // El ID del documento es el uid del vendedor. Solo acepta los campos que
    // escribe el portal; las Cloud Functions la leen con el Admin SDK.
    match /sellerPrefs/{prefUid} {
      allow read: if isAdmin() || (isActiveSeller() && request.auth.uid == prefUid);
      allow create, update: if isActiveSeller() && request.auth.uid == prefUid &&
        request.resource.data.keys().hasOnly(['sellerId', 'emailAddr', 'updatedAt', 'venta', 'apartada', 'liq', 'stock', 'email', 'push', 'fcmToken']);
      allow delete: if isAdmin();
    }

    // ---- Catálogo controlado por el panel admin ----
    match /admin_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_overrides/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_meta/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Reseñas: solo se escriben desde /api/submit-review.js ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Pedidos ----
    match /orders/{orderNum} {
      // Un pedido puntual por su número: público (rastreo sin cuenta).
      allow get: if true;
      // Listar TODOS los pedidos: solo admin.
      allow list: if isAdmin();

      // Crear: el cliente (sin cuenta) solo puede crear un pedido
      // "pendiente" cuyo número coincida con el ID del documento. Ya NO puede
      // crearlo como "pagado": marcar un pedido como pagado es solo del
      // webhook de Stripe (Admin SDK) o del admin. El sitio guarda el pedido
      // como "pendiente" ANTES de cobrar, así que el flujo normal no cambia.
      allow create: if isAdmin() || (
        request.resource.data.paymentStatus == 'pendiente' &&
        request.resource.data.orderNum == orderNum
      );

      // Actualizar: el cliente solo puede marcar SU pedido como
      // "fallido" (campos de pago fallido), y ya NO si el pedido está pagado.
      allow update: if isAdmin() || (
        resource.data.paymentStatus != 'pagado' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paymentFailReason', 'paymentFailedAt']) &&
        request.resource.data.paymentStatus == 'fallido'
      );

      allow delete: if isAdmin();
    }

    // ---- Historial de precios (gráfica pública de cada producto) ----
    // Lectura pública; ya NO se puede escribir desde el navegador:
    // lo registra el webhook de Stripe (Admin SDK) con el pago confirmado.
    match /priceHistory/{entryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- Presencia en vivo ("X personas viendo esto ahora") ----
    // Solo se acepta exactamente { at: número }.
    match /productPresence/{productId}/viewers/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['at'])
                              && request.resource.data.at is number;
      allow delete: if true;
    }

    // ---- Suscripciones push ----
    // Cualquier visitante puede registrar SU dispositivo, pero solo con
    // la forma exacta que genera el navegador y solo de los servicios de push
    // reales (evita que alguien registre direcciones arbitrarias a las que el
    // servidor intentaría mandar notificaciones).
    match /push_subscriptions/{subId} {
      allow create: if request.resource.data.keys().hasOnly(['subscription', 'createdAt'])
                      && request.resource.data.createdAt is number
                      && request.resource.data.subscription is map
                      && request.resource.data.subscription.size() <= 3
                      && request.resource.data.subscription.endpoint is string
                      && request.resource.data.subscription.endpoint.size() < 800
                      && request.resource.data.subscription.endpoint.matches(
                           'https://([a-z0-9-]+\\.)*(googleapis\\.com|mozilla\\.com|apple\\.com|windows\\.com)/.*');
      allow read, update, delete: if isAdmin();
    }

    // ---- Inventario en vivo ----
    // Lectura pública (el sitio muestra el stock en tiempo real).
    // Escritura SOLO del admin (panel de productos y devoluciones). Las
    // compras ya no escriben aquí desde el navegador: las reserva el servidor
    // con el Admin SDK (/api/send-email (type "stock-reserve")), que ignora estas reglas.
    match /inventory/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Reservas de stock: solo servidor (Admin SDK) ----
    match /stockReservations/{resId} {
      allow read, write: if false;
    }

    // ---- Códigos de verificación de correo: solo servidor (Admin SDK) ----
    match /emailOtps/{uid} {
      allow read, write: if false;
    }

    // ---- Newsletter (popup "10% en tu primera compra") ----
    match /newsletterSubscribers/{email} {
      allow create, update: if request.resource.data.keys().hasOnly(['email', 'date'])
                              && request.resource.data.email is string
                              && request.resource.data.email.size() < 200;
      allow read, delete: if isAdmin();
    }

    // ---- Aviso de Drop en vivo ----
    // Solo el dueño del correo (sesión de Firebase con ESE correo)
    // o el admin puede crear, editar o borrar.
    match /dropSubscribers/{email} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'date']) &&
        request.resource.data.email.size() < 200 &&
        isOwnerEmail(request.resource.data.email)
      );
      allow update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'date']) &&
        request.resource.data.email.size() < 200 &&
        isOwnerEmail(resource.data.get('email', '')) &&
        isOwnerEmail(request.resource.data.email)
      );
      allow delete: if isAdmin() || isOwnerEmail(resource.data.get('email', ''));
      allow read: if isAdmin();
    }

    // ---- Carrito abandonado ----
    // El navegador ya no puede marcar "correo enviado" (emailSent /
    // emailSentAt): eso solo lo hace /api/send-abandoned-cart-emails.js con el
    // Admin SDK. Sí puede poner emailSent:false al re-guardar un carrito nuevo.
    match /abandonedCarts/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'items', 'total', 'updatedAt', 'status', 'emailSent', 'emailSentAt'])
                      && request.resource.data.email is string
                      && request.resource.data.email.size() < 200
                      && (!('items' in request.resource.data) ||
                          (request.resource.data.items is list && request.resource.data.items.size() <= 50))
                      && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'recovered'])
                      && (!('emailSent' in request.resource.data) || request.resource.data.emailSent == false)
                      && !('emailSentAt' in request.resource.data);
      allow update: if request.resource.data.keys().hasOnly(['email', 'items', 'total', 'updatedAt', 'status', 'emailSent', 'emailSentAt'])
                      && request.resource.data.email is string
                      && request.resource.data.email.size() < 200
                      && (!('items' in request.resource.data) ||
                          (request.resource.data.items is list && request.resource.data.items.size() <= 50))
                      && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'recovered'])
                      && (request.resource.data.get('emailSent', false) == false ||
                          request.resource.data.get('emailSent', false) == resource.data.get('emailSent', false))
                      && request.resource.data.get('emailSentAt', null) == resource.data.get('emailSentAt', null);
      allow read, delete: if isAdmin();
    }

    // Por defecto, todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
